---
import ToolLayout from "../layouts/ToolLayout.astro";
import JsonForVal from "../components/ToolComponent/JsonForVal"
import jsonFormat from '../content/jsonFormat.json'

const {toolName, metaDescription, introTitle, introText, steps, faqs, glossary, initialText, initialDesc} = jsonFormat

 
---

<ToolLayout title={toolName} desc={metaDescription} introText={introText} introTitle={introTitle} steps={steps} faqs={faqs} glossary={glossary} initialText={initialText} initialDesc = {initialDesc}>
    <div class="flex flex-col p-3 gap-2">
        <div class="text-white text-2xl flex justify-between font-bold">
            JSON Formatter 
        </div>
        <div class="text-gray-500 flex justify-between">
            <p class="text-sm">Format, Validate and Beautify your JSON Data</p>
        </div>

        <div class="flex justify-start">
           <JsonForVal client:load/>
        </div>

        <div>
            
        </div>
    </div>
</ToolLayout>