---
import ToolLayout from "../layouts/ToolLayout.astro";
import HexRgb from "../components/ToolComponent/HexRgb";
import hexrgb from "../content/hexrgb.json"

const {toolName, metaDescription, introTitle, introText, steps, faqs, glossary, initialText, initialDesc} = hexrgb

---

<ToolLayout title={toolName} desc={metaDescription} introText={introText} introTitle={introTitle} steps={steps} faqs={faqs} glossary={glossary} initialText={initialText} initialDesc = {initialDesc}>
    <div class="flex flex-col p-3 gap-2">
        <div class="text-white text-2xl flex justify-between font-bold">
            HEX to RGB 
        </div>
        <div class="text-gray-500 flex justify-between">
            <p class="text-sm">Convert HEX color values to RGB, RGBA, HSL, HSLA formats</p>
        </div>

        <div class="flex justify-start">
           <HexRgb client:load/>
        </div>

        <div>
            <div>
                <p>
                    A Guide To Our JSON World
                </p>

            </div>
        </div>
    </div>
</ToolLayout>