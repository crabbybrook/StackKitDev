---
import ToolLayout from "../layouts/ToolLayout.astro";
import Csvjson from "../components/ToolComponent/Csvjson";
import csvJson from "../content/csvJson.json"

const {toolName, metaDescription, introTitle, introText, steps, faqs, glossary, initialText, initialDesc} = csvJson

---

<ToolLayout title={toolName} desc={metaDescription} introText={introText} introTitle={introTitle} steps={steps} faqs={faqs} glossary={glossary} initialText={initialText} initialDesc = {initialDesc}>
    <div class="flex flex-col p-3 gap-2">
        <div class="text-white text-2xl flex justify-between font-bold">CSV To JSON</div>
        <div class="text-gray-500 flex justify-between">
            <p class="text-sm">Convert CSV data into JSON format</p>
        </div>

        <div class="flex justify-start">
            <Csvjson client:load/>
        </div>
    </div>
</ToolLayout>
