---
import Layout404 from "../layouts/Layout404.astro";
---

<Layout404>
    <div class="h-screen p-5">
        <div
            class="flex flex-col items-center justify-center min-h-screen text-center px-4"
        >
            <h1 class="text-6xl font-bold text-white mb-4">404</h1>
            <h2 class="text-2xl font-semibold text-white mb-2">
                Page Not Found
            </h2>
            <p class="text-white mb-6">
                Sorry, we couldn't find the page you're looking for :(
            </p>
            <a
                href="/"
                class="px-6 py-3 text-white bg-blue-600 rounded-md hover:bg-blue-700 transition"
            >
                Go Back Home
            </a>
        </div>
    </div>
</Layout404>
