---
import ToolLayout from "../layouts/ToolLayout.astro";
import URLEncDec from '../components/ToolComponent/URLEncDec'
import url from "../content/url.json"

const {toolName, metaDescription, introTitle, introText, steps, faqs, glossary, initialText, initialDesc} = url

---

<ToolLayout title={toolName} desc={metaDescription} introText={introText} introTitle={introTitle} steps={steps} faqs={faqs} glossary={glossary} initialText={initialText} initialDesc = {initialDesc}>
    <div class="flex flex-col p-3 gap-2">
        <div class="text-white text-2xl flex justify-between font-bold">
            URL Encode / Decode
        </div>
        <div class="text-gray-500 flex justify-between">
            <p class="text-sm">Encode or decode URL strings</p>
        </div>

        <div class="flex justify-start">
           <URLEncDec client:load/>
        </div>

        <div>
            <div>
                <p>
                    A Guide To Our JSON World
                </p>

            </div>
        </div>
    </div>
</ToolLayout>